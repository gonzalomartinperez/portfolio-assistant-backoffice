# Local frontend on :3001 talking directly to a separately managed fixture API.
# Public build-time origin only; never put secrets here.
NEXT_PUBLIC_ASSISTANT_API_URL=http://localhost:8000
# Production image deliberately omits this variable: browser uses relative /api/v1.

# Coolify/vps-ops runs the prebuilt image with its PORT=3000/HOSTNAME=0.0.0.0 defaults.
# Public URL changes require rebuilding. The frontend requires no runtime secrets.
# See docs/deployment-contract.md; no deployment trigger is configured here.

# Server runtime: exact comma-separated portfolio frame origins; no wildcards.
# Local embed harness: http://localhost:3110
EMBED_ALLOWED_ORIGINS=https://gonzalomartinperez.com

# Backoffice server-only authentication. Placeholder values are not credentials.
# Public production origins require HTTPS; exact loopback HTTP is permitted for local tests.
BACKOFFICE_ORIGIN=http://localhost:3001
BACKOFFICE_DATABASE_URL=postgresql://backoffice:REPLACE_ME@localhost:5432/backoffice_test
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BACKOFFICE_OWNER_EMAIL=owner@example.com
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME
GITHUB_CLIENT_ID=REPLACE_ME
GITHUB_CLIENT_SECRET=REPLACE_ME
