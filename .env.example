# Safe schema only. Replace values in gitignored .env.local, never in an image/build arg.
# Server-runtime authentication; HTTPS except exact loopback development origins.
BACKOFFICE_ORIGIN=http://localhost:3001
BACKOFFICE_DATABASE_URL=postgresql://backoffice:REPLACE_ME@localhost:5432/backoffice_test
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BACKOFFICE_OWNER_EMAIL=owner@example.com
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME
GITHUB_CLIENT_ID=REPLACE_ME
GITHUB_CLIENT_SECRET=REPLACE_ME

# Optional private server-only operations integration; leave absent until committed handoff.
# Never use NEXT_PUBLIC_ for a service origin or token.
# OPERATIONS_API_ORIGIN=http://api-private:8000
# OPERATIONS_READ_TOKEN=REPLACE_ME
# OPERATIONS_SOURCE_MODE=fixture is local synthetic testing only; omit in production.

# Coolify/vps-ops runs the image with PORT=3000 and HOSTNAME=0.0.0.0 defaults.
# Runtime configuration changes require restart, not rebuild. No deployment is authorized.
