{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assistant embed protocol v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type",
        "preferences",
        "visible"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "host.initialize"
        },
        "preferences": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "theme",
            "locale"
          ],
          "properties": {
            "theme": {
              "enum": [
                "dark",
                "light"
              ]
            },
            "locale": {
              "enum": [
                "en",
                "es"
              ]
            }
          }
        },
        "visible": {
          "type": "boolean"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type",
        "preferences"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "host.preferences"
        },
        "preferences": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "theme",
            "locale"
          ],
          "properties": {
            "theme": {
              "enum": [
                "dark",
                "light"
              ]
            },
            "locale": {
              "enum": [
                "en",
                "es"
              ]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type",
        "visible"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "host.visibility"
        },
        "visible": {
          "type": "boolean"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "host.focus"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type",
        "status"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "assistant.ready"
        },
        "status": {
          "enum": [
            "initializing",
            "ready",
            "unavailable",
            "expired"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "assistant.request-minimize"
        }
      }
    }
  ]
}
